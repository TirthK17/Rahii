# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
lib/
.next/
out/

# Firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Environment and secrets (Keep .env.example tracked)
.env
.env.local
.env.*.local
*.local
serviceAccountKey.json
service-account*.json
*.pem
*.key

# Testing and coverage
coverage/
.nyc_output/

# Logs
logs/
*.log

# IDE & Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Temp files
tmp/
temp/

# Media files (videos, presentations, audio) — exclude large/demo media
*.mp4
*.avi
*.mov
*.wmv
*.pdf
*.ppt
*.pptx
*.ogg
*.mp3
*.wav
# Keep app UI assets: frontend/public/*.mp4 is intentionally tracked
!frontend/public/raahi-intro.mp4

# Random / unnamed media files at root
*.png
# Keep intentional images
!frontend/public/*.png
!frontend/public/*.svg
!public/*.png
